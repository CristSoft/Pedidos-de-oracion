  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-static": "^1.52.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  },
  "description": "Aplicación web para recibir, administrar y compartir pedidos de oración, con Firebase y resúmenes mediante Gemini.",
