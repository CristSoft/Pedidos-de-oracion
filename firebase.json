{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": { "port": 8089 },
    "ui": { "enabled": false }
  },
  "hosting": {
    "site": "pedidos-de-oracion-sur",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
