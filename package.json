{
  "name": "unidos-en-oracion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-prayer-rules \"node --test tests/firestore-rules.mjs\"",
